;; vim: set ft=racket:
;; it's not racket but i just need hl and comments

(defcfg process-unmapped-keys yes)

(defsrc
  ;; fn + esc = grv
  ;; fn + num = F<num>
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc del
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \    pgup
  caps a    s    d    f    g    h    j    k    l    ;    '    ret       pgdn
  lsft z    x    c    v    b    n    m    ,    .    /    rsft      up   ;;fn
  lctl lmet lalt           spc            ralt rctl           lft  down rght)

(deftemplate smart-shift-tap-hold (tt ht sh tap hold)
    (switch
        ;; shift hold before = $sh
        ((or lsft rsft)) $sh break

        ;; tap = $tap
        ;; hold + <key> = $hold + <key>
        ;; hold after timeout = $tap
        () (tap-hold-press-timeout $tt $ht $tap $hold $tap) break))

(defvar
    hyper lmet
    timeout 300)


(defalias
  HPR (t! smart-shift-tap-hold $timeout $timeout caps esc $hyper)
  ;; hyper + del = print (kanata can't see fn on this kbd)
  del-prnt (fork del prnt (lmet rmet)))
  ;; HPR hyper)

(deflayer base
  _    _    _    _    _    _    _    _    _    _    _    _    _    _    @del-prnt
  _    _    _    _    _    _    _    _    _    _    _    _    _    _    _
  @HPR _    _    _    _    _    _    _    _    _    _    _    _         _
  _    _    _    _    _    _    _    _    _    _    _    _         _
  _    _    _              _              _    _              _    _    _)


